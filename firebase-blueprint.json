{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and reminder preferences",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastActive": { "type": "string" },
        "reminderSettings": { "type": "object" }
      }
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Private user journal entry and Gita reflection",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "mood": { "type": "string" },
        "theme": { "type": "string" },
        "summary": { "type": "string" },
        "conversation": { "type": "array" },
        "verse": { "type": "object" },
        "guidance": { "type": "string" },
        "patternRecallNote": { "type": "string" },
        "location": { "type": "object" }
      },
      "required": ["title", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User document containing profile and settings"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "User private journal entries"
    }
  }
}

